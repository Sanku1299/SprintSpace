# Copy this file to .env.local for local development.
# Keep secrets in .env.local; never commit that file.
# Server-only values must not use the NEXT_PUBLIC_ prefix.

# Database connection (introduced in Phase 2)
# MONGODB_URI=

# Authentication (introduced in Phase 3)
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
# Generate AUTH_SECRET locally with `npx auth secret`; do not copy a real secret into this file.

# Add object-storage values only after a provider is selected.
