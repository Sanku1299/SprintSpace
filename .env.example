# Copy this file to .env.local for local development.
# Keep secrets in .env.local; never commit that file.
# Server-only values must not use the NEXT_PUBLIC_ prefix.

# Database connection. Use a production replica-set URI for transactions.
# MONGODB_URI=

# Authentication. Set AUTH_URL to the production origin when self-hosting.
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
# Generate AUTH_SECRET locally with `npx auth secret`; do not copy a real secret into this file.

# Optional demo login defaults. When set, both values are rendered into the login page
# for visitors to use. Only use a disposable demo account and non-production data.
# DEMO_LOGIN_EMAIL=
# DEMO_LOGIN_PASSWORD=

# S3-compatible object storage (AWS S3, MinIO, R2, or another compatible provider).
# The bucket and region are required for attachment flows. Keep the bucket private.
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=
